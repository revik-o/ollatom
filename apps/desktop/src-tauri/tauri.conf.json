{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ollatom",
  "version": "1.0.0",
  "identifier": "ollatom",
  "build": {
    "frontendDist": "../dist/ollatom-desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ollatom",
        "width": 800,
        "height": 600,
        "minWidth": 330,
        "minHeight": 240,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "visible": false,
        "transparent": false,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "deb", "rpm", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
