{
  "name": "ollatom-desktop",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "tauri": "tauri",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "lint-staged --cwd .",
    "prepare": "cd ../.. && husky apps/desktop/.husky",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:install": "playwright install chromium",
    "tauri:build:linux": "tauri build --features wayland-blur",
    "tauri:build:macos:store": "tauri build --config src-tauri/tauri.macos-store.conf.json",
    "tauri:build:macos:direct": "tauri build --config src-tauri/tauri.macos-direct.conf.json --features macos-direct"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,html,css,scss,json,jsonc,md,yaml,yml}": "prettier --write"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.33.0",
    "@tauri-apps/api": "^2.11.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "husky": "9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
